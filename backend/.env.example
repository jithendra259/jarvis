# JARVIS Backend Environment Configuration

# Server Networking
JARVIS_ENV=development
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000

# Local LLM: OmniRoute & Ollama
OMNIROUTE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=sk-local-jarvis
OLLAMA_URL=http://localhost:11434
DEFAULT_MODEL=auto/best-chat
FAST_MODEL=auto/best-fast
REASONING_MODEL=auto/best-reasoning

# Local LiveKit (Self-Hosted)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Inference Hardware
STT_DEVICE=auto
STT_COMPUTE_TYPE=auto
TTS_ENGINE=kokoro
TTS_DEVICE=auto
TTS_VOICE=af_bella
