# JARVIS Backend Environment Configuration
# Copy this file to backend/.env and adjust values as needed

# =============================================================================
# Server Networking
# =============================================================================
JARVIS_ENV=development
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000

# =============================================================================
# Local LLM: OmniRoute & Ollama
# =============================================================================
# OmniRoute runs a local gateway (default: http://127.0.0.1:20128/v1)
# Get it from: https://github.com/omniroute/omniroute
OMNIROUTE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=sk-local-jarvis

# Ollama runs locally (default: http://127.0.0.1:11434)
OLLAMA_URL=http://127.0.0.1:11434

# Model selection (use local model names from Ollama, e.g. qwen2.5:7b-instruct)
# For OmniRoute, use the model aliases it exposes (e.g. auto/best-chat)
DEFAULT_MODEL=qwen2.5:7b-instruct
FAST_MODEL=qwen2.5:3b-instruct
REASONING_MODEL=qwen2.5:7b-instruct

# Which provider to use: auto | omniroute | ollama
# auto = try OmniRoute first, fall back to Ollama
LLM_PROVIDER=auto

# LLM timeouts
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOOL_ITERATIONS=3

# =============================================================================
# Local LiveKit (Self-Hosted)
# =============================================================================
# Start LiveKit server: docker run --rm -p 7880:7880 livekit/livekit-server --dev
# Or build from source: https://github.com/livekit/livekit
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_ROOM=jarvis-room

# =============================================================================
# Data Paths (User data stored outside installation directory)
# =============================================================================
# Override with JARVIS_DATA_DIR to use a custom location
# Default: %LOCALAPPDATA%\Jarvis (Windows) or ~/.local/share/jarvis (Linux)
# JARVIS_DATA_DIR=
# DATABASE_PATH=  # defaults to <data_dir>/database/jarvis.db

# =============================================================================
# Voice Pipeline (Phase 4/5) - Local Models
# =============================================================================
# STT: Whisper Large V3 Turbo (faster-whisper)
STT_MODEL_PATH=
STT_DEVICE=auto          # auto | cuda | cpu
STT_COMPUTE_TYPE=auto    # auto | float16 | int8 | int8_float16
STT_LANGUAGE=en

# TTS: Kokoro (primary) or Piper (fallback)
TTS_ENGINE=kokoro        # kokoro | piper
TTS_MODEL_PATH=
TTS_VOICE=af_heart       # Kokoro voice name
TTS_DEVICE=auto
TTS_SAMPLE_RATE=24000

# VAD: Silero
VAD_ENABLED=true
VAD_SAMPLE_RATE=16000

# =============================================================================
# Logging
# =============================================================================
JARVIS_LOG_LEVEL=INFO    # DEBUG | INFO | WARNING | ERROR

# =============================================================================
# CORS (for Tauri webview + Next.js dev)
# =============================================================================
# Comma-separated origins
JARVIS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://tauri.localhost,https://tauri.localhost,tauri://localhost

# =============================================================================
# Confirmation TTL
# =============================================================================
CONFIRMATION_TTL_SECONDS=300